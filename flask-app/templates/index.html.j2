<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meshcore Node List</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles-new.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <h1>Meshcore Node List</h1>
    <h3>(heard in the past 48 hours)</h2>

    <div class="table-container">
        <div class="table-toolbar">
            {% if google_maps_api_key %}
                <button id="view-map-btn">View Map</button>
            {% else %}
                <p style="text-align: center;"><i>Set the GOOGLE_MAPS_API_KEY environment variable to enable the map view.</i></p>
            {% endif %}
        </div>
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    {% for header in headers %}
                        <th>{{ header }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in data %}
                <tr>
                    <td>{{ loop.index }}</td>
                    {% for cell in row %}
                        <td>{{ cell|safe }}</td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Map Modal -->
    <div id="map-modal" class="modal">
        <div class="modal-content">
            <span class="close-button">&times;</span>
            <h2>Node Map</h2>
            <div id="map-container">Loading map...</div>
        </div>
    </div>

    <footer>
        <p>Version {{ version }} | Last updated: {{ last_modified }}</p>
    </footer>

    {% if google_maps_api_key %}
    <script src="{{ url_for('static', filename='js/map.js') }}"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap&libraries=marker" async></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('map-modal');
            const btn = document.getElementById('view-map-btn');
            const span = document.getElementsByClassName('close-button')[0];

            if (btn) {
                btn.onclick = function() {
                    modal.style.display = 'block';
                    
                    // When the modal is opened, resize the map and fit the markers.
                    if (window.mapInitialized) {
                        google.maps.event.trigger(window.map, "resize");
                        if (window.markers && window.markers.length > 1) {
                            window.map.fitBounds(window.bounds);
                        } else if (window.markers && window.markers.length === 1) {
                            window.map.setCenter(window.bounds.getCenter());
                            window.map.setZoom(12);
                        }
                    }
                }
            }

            if (span) {
                span.onclick = function() {
                    modal.style.display = 'none';
                }
            }

            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = 'none';
                }
            }
        });
    </script>
    {% endif %}

</body>
</html>
